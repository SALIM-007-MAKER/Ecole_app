# Secrets et configuration locale — ne jamais versionner
.env
.env.production

# Cache, files d'attente, sauvegardes et stockage tenant générés à l'exécution
storage/cache/*
!storage/cache/.gitkeep
storage/tenants/*
!storage/tenants/.gitkeep

# Dumps SQL locaux (sauvegardes prises avant une migration destructive) —
# peuvent contenir des données personnelles réelles, jamais versionnés
database/backups/

# Fichiers uploadés par les utilisateurs
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess

# Logs
*.log

# Fichiers système
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Binaire Tailwind autonome (non versionne, voir tools/tailwind/README.md)
tools/tailwind/tailwindcss.exe
tools/tailwind/tailwindcss
