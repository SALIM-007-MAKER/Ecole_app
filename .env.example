# ─────────────────────────────────────────────────────────────────────────────
# Ecole App — Exemple de configuration (.env)
# Copiez ce fichier en .env et adaptez les valeurs à votre environnement.
# Ne versionnez JAMAIS le fichier .env.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="Ecole App"
APP_ENV=production          # development | production
APP_DEBUG=false             # true en dev uniquement — JAMAIS true en prod
APP_URL=http://localhost/ecole_app
APP_KEY=                    # Générer : php -r "echo bin2hex(random_bytes(32));"
APP_TIMEZONE=Africa/Algiers

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ecole_app
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=7200       # Durée de vie en secondes (7200 = 2h)
SESSION_NAME=ecole_session

# Upload de fichiers
UPLOAD_MAX_SIZE=5242880     # Taille maximale en octets (5 Mo)
UPLOAD_PATH=storage/uploads

# ─── Email (optionnel) ────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ecole.dz
MAIL_FROM_NAME="Ecole App"
MAIL_FROM_EMAIL=noreply@ecole.dz
MAIL_REPLY_TO=

# ─── SMS Gateway (optionnel) ─────────────────────────────────────────────────
SMS_GATEWAY_URL=
SMS_SENDER=EcoleApp
SMS_API_KEY=
SMS_DRIVER=
SMS_API_URL=
SMS_PAYLOAD_TPL=
SMS_COUNTRY_CODE=213

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=error             # debug | info | warning | error | critical

# ─── Multi-Tenant (Phases 14.2-14.11) ────────────────────────────────────────
# TENANT_MODE_ENABLED est un indicateur documentaire uniquement : il n'active PAS
# TenantMiddleware (dormant par conception) — voir docs/technique/MULTI_TENANT.md.
TENANT_MODE_ENABLED=false
TENANT_DEFAULT_ID=1
TENANT_BASE_DOMAIN=

# ─── API Platform (JWT / CORS) ────────────────────────────────────────────────
JWT_SECRET=                 # défaut : APP_KEY si absent — définir une valeur dédiée en production
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 jours
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_UPLOAD_MAX_SIZE=10485760  # 10 Mo

# ─── Cache (Phase 14.9) ───────────────────────────────────────────────────────
CACHE_DRIVER=file           # file (fonctionnel) | redis (stub non fonctionnel — voir docs/technique/MULTI_TENANT.md)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Stockage (Phase 14.8) ────────────────────────────────────────────────────
STORAGE_DRIVER=local        # local (fonctionnel) | s3 (stub non fonctionnel)
STORAGE_SIGNING_KEY=        # défaut : APP_KEY si absent
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
