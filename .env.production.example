# ─────────────────────────────────────────────────────────────────────────────
# Ecole App — MODÈLE de configuration de PRODUCTION
#
# Ce fichier est un modèle : il ne contient AUCUN secret et ne doit jamais en contenir.
# Sur le serveur : copier en `.env` (ou `.env.production` selon l'hébergement), remplir chaque
# valeur marquée A_DEFINIR, puis restreindre les droits du fichier (lecture par le seul compte du
# serveur web). Ne JAMAIS le versionner une fois rempli.
#
# Règles du fichier .env de ce projet :
#  - un commentaire se met sur sa PROPRE ligne (pas en fin de ligne : non géré) ;
#  - pas de guillemets inutiles ; pas d'espace autour du « = ».
# Référence complète des variables : docs/deploiement/VARIABLES_ENVIRONNEMENT.md
# Déroulé de la mise en production : docs/deploiement/CHECKLIST_PRODUCTION.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Ecole App
# production obligatoire : désactive les comportements de développement.
APP_ENV=production
# false OBLIGATOIRE : true afficherait des erreurs détaillées aux visiteurs.
APP_DEBUG=false
# URL publique en HTTPS, sans slash final. Elle sert aussi de base aux passkeys (WebAuthn) :
# la changer après l'enregistrement de passkeys les rend inutilisables.
APP_URL=https://A_DEFINIR.exemple.org
# 64 caractères hexadécimaux. Générer : php -r "echo bin2hex(random_bytes(32));"
# Chiffre les secrets 2FA ; la modifier invalide toutes les 2FA et tous les codes de secours.
APP_KEY=A_DEFINIR
APP_TIMEZONE=Africa/Algiers

# ── Secrets distincts (chacun généré séparément, jamais la même valeur) ──────
# QR codes de vérification des bulletins : 64 caractères hexadécimaux minimum, sans repli.
BULLETIN_TOKEN_SECRET=A_DEFINIR
# Jetons de l'API.
JWT_SECRET=A_DEFINIR
# Liens de téléchargement signés.
STORAGE_SIGNING_KEY=A_DEFINIR

# ── Base de données ──────────────────────────────────────────────────────────
# Créer un utilisateur MySQL DÉDIÉ à l'application (pas root), limité à cette base.
DB_HOST=A_DEFINIR
DB_PORT=3306
DB_DATABASE=A_DEFINIR
DB_USERNAME=A_DEFINIR
DB_PASSWORD=A_DEFINIR

# ── Réseau et sessions ───────────────────────────────────────────────────────
# Adresses du reverse proxy autorisé à fournir X-Forwarded-For / X-Forwarded-Proto (séparées par des
# virgules). Vide si le serveur est exposé directement. Mal renseigné, la limitation des tentatives
# de connexion se fonde sur la mauvaise adresse IP.
TRUSTED_PROXIES=
SESSION_LIFETIME=7200
SESSION_NAME=ecole_session
# Domaines réels autorisés pour l'API, séparés par des virgules. Jamais d'adresse localhost en production.
CORS_ORIGINS=https://A_DEFINIR.exemple.org

# ── E-mail (alertes de sécurité des opérateurs, réinitialisations) ───────────
# Sans SMTP, les alertes de sécurité par e-mail sont inactives. Voir docs/deploiement/EMAIL_GMAIL.md
# (mot de passe d'APPLICATION, pas le mot de passe du compte).
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=A_DEFINIR
MAIL_PASSWORD=A_DEFINIR
# Avec Gmail, MAIL_FROM_EMAIL doit être identique à MAIL_USERNAME.
MAIL_FROM_EMAIL=A_DEFINIR
MAIL_FROM_NAME=Ecole App

# ── Portail plateforme (Super-Admin SaaS) ────────────────────────────────────
# 1 = double authentification obligatoire pour tous les opérateurs. Ne la rendre obligatoire
# qu'APRÈS que chaque opérateur actif l'a activée (ou depuis /platform/parametres).
PLATFORM_REQUIRE_2FA=0
# 1 = e-mail d'alerte à chaque connexion d'un opérateur.
PLATFORM_NOTIFY_LOGIN=1
PLATFORM_DEFAULT_CURRENCY=XOF
# Passkeys : déduits de APP_URL si absents. À définir seulement si le portail est servi sous un
# autre domaine que APP_URL, ou pour un RP ID couvrant les sous-domaines.
# PLATFORM_WEBAUTHN_ORIGIN=https://plateforme.exemple.org
# PLATFORM_WEBAUTHN_RP_ID=exemple.org

# ── Bulletins ────────────────────────────────────────────────────────────────
# Interrupteur de publication des bulletins : FERMÉ par défaut. À ouvrir (true) seulement après la
# revue des droits (academique.bulletin.publish / academique.bulletin.admin).
BULLETIN_PUBLICATION_ENABLED=false

# ── Fichiers, journaux, cache ────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=storage/uploads
LOG_LEVEL=error
LOG_RETENTION_DAYS=90
CACHE_DRIVER=file
STORAGE_DRIVER=local

# ── Multi-établissements ─────────────────────────────────────────────────────
TENANT_MODE_ENABLED=false
TENANT_DEFAULT_ID=1
TENANT_BASE_DOMAIN=

# ── Notifications push (facultatif) ──────────────────────────────────────────
# Paire de clés VAPID générée avec les outils du projet. La clé privée ne se versionne jamais.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:A_DEFINIR@exemple.org
